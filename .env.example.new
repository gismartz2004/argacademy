# Database Configuration
# Para desarrollo local: postgresql://user:password@localhost:5432/tech_ascent
# Para Cloud SQL: postgresql://appuser:password@/tech_ascent?host=/cloudsql/PROJECT_ID:us-central1:tech-ascent-db
DATABASE_URL=postgresql://user:password@localhost:5432/tech_ascent

# Session Secret - cambiar en producción
SESSION_SECRET=your-production-secret-key-here

# Server Configuration
PORT=5000
NODE_ENV=development